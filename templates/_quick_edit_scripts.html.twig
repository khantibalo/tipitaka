{% set codeUrl = (showCode and sentence is defined) ? path('quote_code', {sentencetranslation: 'stidParam', paragraphid: sentence.paragraphid}) : '' %}
{% set shiftDownLink = (showAlign and not node.disabletranslalign) ? path('shiftdown', {translationid: 'stidParam'}) : '' %}
{% set shiftUpLink = (showAlign and not node.disabletranslalign) ? path('shiftup', {translationid: 'stidParam'}) : '' %}
{% if showAlign %}
	{% set translateUrl = path('translation_edit', {sentenceid: 'sentenceidParam', sourceid: 'sourceidParam', return: 'node', showAlign: 'yes'}) %}
	{% set editUrl = path('translation_edit', {translationid: 'stidParam', return: 'node', showAlign: 'yes'}) %}
{% else %}
	{% set translateUrl = path('translation_edit', {sentenceid: 'sentenceidParam', sourceid: 'sourceidParam', return: 'node'}) %}
	{% set editUrl = path('translation_edit', {translationid: 'stidParam', return: 'node'}) %}
{% endif %}
<script type="application/json" id="quickEditConfig">
{{ {
	ajaxRoot: asset('ajax'),
	saveError: 'Save error'|trans,
	translateText: 'Translate'|trans,
	quickEditText: 'Quick Edit'|trans,
	editText: 'Edit'|trans,
	saveText: 'Save'|trans,
	cancelText: 'Cancel'|trans,
	codeText: 'Code'|trans,
	codeUrl: codeUrl,
	shiftDownText: 'Shift down'|trans,
	shiftUpText: 'Shift up'|trans,
	shiftDownLink: shiftDownLink,
	shiftUpLink: shiftUpLink,
	translateUrl: translateUrl,
	editUrl: editUrl
}|json_encode|raw }}
</script>
<script src="https://code.jquery.com/jquery-3.5.0.min.js"></script>
{# <script type="text/javascript" src="{{ asset('jquery-3.5.0.js') }}"></script>  #}
<script type="text/javascript" src="{{ asset('scripts.js') }}"></script>
{# quickEditConfig above no longer needs to precede scripts.js: it is read on jQuery's document-ready handler #}
